/**
 * Brand Studio -- local employee tool.
 * Write API exists only during `astro dev` (Vite plugin).
 */
import Layout from '../../layouts/Layout.astro';
import { brand } from '../../data/brand';
import { brandSitemap, sitemapDefaults } from '../../data/brand-sitemap';
import {
