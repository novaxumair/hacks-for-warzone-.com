							updateSitemapDomain();
							const warns = Array.isArray(data.warnings) ? data.warnings : [];
							const msg =
								(data.message || data.sync || 'Saved permanently to brand.ts.') +
								(warns.length ? ' · Notes: ' + warns.slice(0, 4).join('; ') : '');
							show(msg, true);
							document.getElementById('studio-bar')?.classList.remove('is-dirty');
						}
					} catch (err) {
						show(err instanceof Error ? err.message : 'Network error -- is astro dev running?', false);
					} finally {
						saveBtn.disabled = false;
					}
				});

				updateSerp();
				updateHero();
				updateSitemapDomain();
				loadStatus();
			})();
		</script>
	)
}

