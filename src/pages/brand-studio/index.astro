type BrandRecord = typeof brand & {
	seo?: typeof seoDefaults;
	copy?: typeof copyDefaults;
	sitemap?: typeof brandSitemap;
	theme?: { accent?: string; bg?: string; soft?: string; deep?: string; hover?: string; panel?: string };
};

const b = brand as BrandRecord;
const seo = { ...seoDefaults, ...b.seo };
const copy = { ...copyDefaults, ...b.copy };
const sitemap = {
	...sitemapDefaults,
	...b.sitemap,
	images: b.sitemap?.images?.length ? [...b.sitemap.images] : [...brandSitemap.images],
};
const theme = deriveBrandTheme({
	accent: b.theme?.accent ?? brandTheme.accent,
	bg: b.theme?.bg ?? brandTheme.bg,
	soft: b.theme?.soft ?? brandTheme.accentSoft,
	deep: b.theme?.deep ?? brandTheme.accentDeep,
	hover: b.theme?.hover ?? brandTheme.accentHover,
	panel: b.theme?.panel ?? brandTheme.bgPanel,
});

const identity: Field[] = [
	{
		name: 'name',
		label: 'Brand name',
		tip: 'What: The public name of this site. | Why: Shows in the hero, footer, browser tab titles, and Google schema. | Example: Fortnite Hacks, Apex Cheats, Marathon Hacks',
		value: brand.name,
		required: true,
		maxlength: 80,
	},
	{
		name: 'shortName',
		label: 'Short name',
		tip: 'What: A shorter label if the full brand is long. | Why: Used where space is tight (manifest / compact UI). | Example: Same as brand name, or "FN Hacks"',
