				};

				async function studioFetch(path, options = {}) {
					const headers = {
						'X-Brand-Studio': '1',
						...(options.headers || {}),
					};
					const res = await fetch(path, { ...options, headers });
					let data = null;
					const text = await res.text();
					try {
						data = text ? JSON.parse(text) : null;
					} catch {
						throw new Error(
							res.ok
								? 'Brand Studio returned non-JSON. Restart: npm run dev'
								: 'Brand Studio API unavailable. Restart: npm run dev',
						);
					}
					if (!data || typeof data !== 'object') {
						throw new Error('Empty Brand Studio response. Restart: npm run dev');
					}
					return { res, data };
				}

				async function loadStatus() {
					try {
						const { res, data } = await studioFetch(API.status);
						if (!res.ok || !data.ok) {
							show(data.error || 'API unavailable. Run astro dev.', false);
							return;
						}
						if (data.tokenRequired && tokenField) tokenField.hidden = false;
					} catch (err) {
						show(err instanceof Error ? err.message : 'API offline. Start with: npm run dev', false);
					}
				}

