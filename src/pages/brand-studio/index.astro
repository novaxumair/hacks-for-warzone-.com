</Layout>

{
	isDev && (
		<script is:inline>
			(() => {
				const root = document.getElementById('studio-root');
				const form = document.getElementById('studio-form');
				const banner = document.getElementById('studio-banner');
				const saveBtn = document.getElementById('save-btn');
				const tokenField = document.getElementById('token-field');
				const tipEl = document.getElementById('studio-tip');
				if (!root || !form || !banner || !saveBtn || !tipEl) return;

				const serpTitle = document.getElementById('serp-title');
				const serpDesc = document.getElementById('serp-desc');
				const serpUrl = document.getElementById('serp-url');
				const serpTitleCount = document.getElementById('serp-title-count');
				const serpDescCount = document.getElementById('serp-desc-count');
				const heroName = document.getElementById('hero-preview-name');
				const heroLede = document.getElementById('hero-preview-lede');

				const host = location.hostname;
				const local = host === 'localhost' || host === '127.0.0.1' || host === '[::1]';
				if (!local) {
					form.hidden = true;
					banner.hidden = false;
					banner.className = 'studio__bar-msg is-err';
					banner.textContent = 'Open this page on http://localhost -- remote hosts are blocked.';
					return;
				}

				let activeSerp = 'home';
				let lastFocus = null;
				let tipTimer = null;
				let tipOverBtn = false;
				let tipOverPopup = false;

				const sectionIds = ['identity', 'product', 'colors', 'seo', 'keywords', 'copy', 'images', 'sitemap'];

				const seoTemplates = {
					homeTitle: '{brand} | Undetected {primaryKeyword}',
					homeDescription:
						'{primaryKeyword} for Windows PC -- ESP, aimbot, and radar with {antiCheat} maintenance. Compare plans and buy.',
					featuresTitle: '{game} Features | {brand}',
					featuresDescription:
						'Everything in one {game} license for Windows PC -- ESP, aimbot, radar, and patch updates.',
					storeTitle: '{game} Store | {brand}',
					storeDescription: 'Monthly and lifetime {game} plans. Same features. Instant delivery after payment.',
					statusTitle: '{game} Status | {brand}',
					statusDescription:
						'Live status for {brand} after {game} or {antiCheat} patches. Check before you queue.',
					previewTitle: '{game} Preview | {brand}',
					previewDescription:
						'Quick preview of {brand} -- ESP, aimbot, radar, and updates after {game} patches.',
					setupTitle: '{game} Setup | {brand}',
					setupDescription: 'Install and launch {brand} on Windows PC. Short setup steps after you buy.',
					supportTitle: '{game} Support | {brand}',
					supportDescription: 'Get help with {brand}. Email {email} with your order ID.',
					faqTitle: '{game} FAQ | {brand}',
					faqDescription: 'Short answers about {brand} — delivery, setup, updates, and refunds.',
					reviewsTitle: '{brand} Reviews | Buyer Feedback',
					reviewsDescription:
						'Real buyer reviews for {brand} — ESP, soft aim, radar, and patch updates on Windows PC.',
					blogTitle: '{game} Intel | {brand}',
					blogDescription: 'Guides and notes for {game} — meta tips, ESP, aimbot, and {antiCheat} updates.',
				};

				const copyTemplates = {
					tagline: 'Undetected {primaryKeyword} -- ESP, aimbot, and radar for PC',
					summary:
						'{brand} is an undetected {game} cheat package for Windows PC. Includes ESP, soft aim, and radar, with {antiCheat} maintenance after patches.',
					heroLede: 'Hacks and cheats available -- 0% detection.',
					blogLabel: '{game} Intel',
					ctaBuy: 'Buy now',
					ctaBuyShort: 'Buy',
					featuresIntro: 'Everything included in one license for {game} on Windows PC.',
					storeIntro: 'Pick a plan. Same features on both. Instant delivery after payment.',
					statusIntro: 'Check here after a {game} or {antiCheat} patch before you play.',
					previewIntro: 'A quick look at {brand} — ESP, aimbot, radar, and updates after patches.',
					setupIntro: 'Install {brand} on Windows PC after you buy. Follow these short steps.',
					supportIntro: 'Need help with {brand}? Email {email} with your order ID.',
					faqIntro: 'Short answers about delivery, setup, updates, and refunds.',
					reviewsIntro: 'Real feedback from {brand} buyers — ESP, soft aim, radar, and support.',
				};

				function show(msg, ok) {
					banner.hidden = false;
					banner.className = 'studio__bar-msg ' + (ok ? 'is-ok' : 'is-err');
					banner.textContent = msg;
				}

				function formatTip(raw) {
					return String(raw || '')
						.split(' | ')
						.map((line) => {
							const m = line.match(/^(What|Why|Example):\s*(.*)$/i);
							if (!m) return line;
							return '<strong>' + m[1] + ':</strong> ' + m[2];
						})
						.join('<br />');
				}

				function hideTip() {
					tipEl.hidden = true;
					tipEl.innerHTML = '';
				}

				function scheduleHideTip() {
					clearTimeout(tipTimer);
					tipTimer = setTimeout(() => {
						if (!tipOverBtn && !tipOverPopup) hideTip();
					}, 180);
				}

				function positionTip(x, y) {
					const pad = 14;
					const maxX = window.innerWidth - tipEl.offsetWidth - 8;
					const maxY = window.innerHeight - tipEl.offsetHeight - 8;
					tipEl.style.left = Math.min(Math.max(8, x + pad), maxX) + 'px';
					tipEl.style.top = Math.min(Math.max(8, y + pad), maxY) + 'px';
				}

				function openTip(btn, x, y) {
					tipEl.innerHTML = formatTip(btn.getAttribute('data-tip'));
					tipEl.hidden = false;
					positionTip(x, y);
				}

				root.addEventListener(
					'mouseover',
					(e) => {
						const btn = e.target.closest('.studio__q');
						if (!btn || !root.contains(btn)) return;
						tipOverBtn = true;
						clearTimeout(tipTimer);
						openTip(btn, e.clientX, e.clientY);
					},
					true
				);

				root.addEventListener(
					'mouseout',
					(e) => {
						const btn = e.target.closest('.studio__q');
						if (!btn || !root.contains(btn)) return;
						tipOverBtn = false;
						scheduleHideTip();
					},
					true
				);

				root.addEventListener('click', (e) => {
					const btn = e.target.closest('.studio__q');
					if (!btn || !root.contains(btn)) return;
					e.preventDefault();
					openTip(btn, e.clientX, e.clientY);
				});

				tipEl.addEventListener('mouseenter', () => {
					tipOverPopup = true;
					clearTimeout(tipTimer);
				});

				tipEl.addEventListener('mouseleave', () => {
					tipOverPopup = false;
					scheduleHideTip();
				});

				document.addEventListener('mousemove', (e) => {
					if (tipEl.hidden) return;
					positionTip(e.clientX, e.clientY);
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') hideTip();
				});

				function val(name) {
					const el = form.elements.namedItem(name);
					return el && 'value' in el ? String(el.value) : '';
				}

				function normalizeSiteUrl(raw) {
					let u = String(raw || '').trim();
					if (!u) return '';
					if (!/^https?:\/\//i.test(u)) u = 'https://' + u;
					u = u.replace(/\/+$/, '');
					try {
						const parsed = new URL(u);
						if (!parsed.hostname) return u;
						return parsed.origin;
					} catch {
						return u;
					}
				}

				function siteHost(raw) {
					const origin = normalizeSiteUrl(raw);
					if (!origin) return '';
					try {
						return new URL(origin).hostname;
					} catch {
						return origin.replace(/^https?:\/\//i, '').split('/')[0];
					}
				}

				function syncEmailFromDomain() {
					const host = siteHost(val('url'));
					if (!host) return;
					const emailEl = form.elements.namedItem('supportEmail');
					if (!emailEl || !('value' in emailEl)) return;
					emailEl.value = 'support@' + host;
				}

				function maybeSyncEmailFromDomain() {
					const box = form.elements.namedItem('syncEmailToDomain');
					const enabled = box && 'checked' in box ? box.checked : true;
					if (!enabled) return;
					const host = siteHost(val('url'));
					if (!host) return;
					const emailEl = form.elements.namedItem('supportEmail');
					if (!emailEl || !('value' in emailEl)) return;
					const current = String(emailEl.value || '').trim();
					const local = current.includes('@') ? current.split('@')[0] : 'support';
					const next = (local || 'support') + '@' + host;
					if (current !== next) emailEl.value = next;
				}

				function updateSitemapDomain() {
					const origin = normalizeSiteUrl(val('url')) || 'https://example.com';
					const host = siteHost(origin) || 'example.com';
					const setText = (id, text) => {
						const el = document.getElementById(id);
						if (el) el.textContent = text;
					};
					setText('sitemap-domain-host', host);
					setText('sitemap-preview-index', origin + '/sitemap.xml');
					setText('sitemap-preview-en', origin + '/sitemap-en.xml');
					setText('sitemap-preview-images', origin + '/sitemap-images.xml');
					setText('sitemap-preview-robots', 'Sitemap: ' + origin + '/sitemap.xml');
					setText('identity-domain-code', origin + '/sitemap.xml');

					root.querySelectorAll('[data-sitemap-abs-for]').foreach((el) => {
						const name = el.getAttribute('data-sitemap-abs-for');
						const path = val(name) || '/images/…';
						const clean = path.startsWith('/') ? path : '/' + path;
						el.textContent = origin + clean;
					});
				}

				function fillTokens(input) {
					return String(input || '')
						.replaceAll('{brand}', val('name'))
						.replaceAll('{game}', val('game'))
						.replaceAll('{antiCheat}', val('antiCheat'))
						.replaceAll('{email}', val('supportEmail'))
						.replaceAll('{primaryKeyword}', val('primaryKeyword'))
						.replaceAll('{checkout}', val('checkoutUrl'));
				}

				function serpFields() {
					return {
						title: activeSerp + 'Title',
						desc: activeSerp + 'Description',
					};
				}

				function updateSerp() {
					const { title: titleKey, desc: descKey } = serpFields();
					const titleEl = form.elements.namedItem(titleKey);
					const descEl = form.elements.namedItem(descKey);
					const rawTitle = titleEl && 'value' in titleEl ? titleEl.value : '';
					const rawDesc = descEl && 'value' in descEl ? descEl.value : '';
					let title = fillTokens(rawTitle);
					let desc = fillTokens(rawDesc);
					// Match live seoDescription() clamp so SERP is accurate
					if (desc.length > 160) desc = desc.slice(0, 157).trim() + '…';
					if (title.length > 70) title = title.slice(0, 67).trim() + '…';

					if (serpTitle) serpTitle.textContent = title || 'Title preview';
					if (serpDesc) serpDesc.textContent = desc || 'Description preview';
					if (serpUrl) {
						const u = val('url').replace(/^https?:\/\//, '').replace(/\/$/, '');
						const paths = {
							home: '/',
							features: '/features/',
							store: '/pricing/',
							status: '/updates/',
							preview: '/warzone-cheats/',
							setup: '/setup/',
							support: '/support/',
							faq: '/faq/',
							reviews: '/reviews/',
							blog: '/blog/',
						};
						const path = paths[activeSerp] || '/';
						serpUrl.textContent = (u || 'example.com') + path;
					}

					const tLen = fillTokens(rawTitle).length;
					const dLen = fillTokens(rawDesc).length;
					if (serpTitleCount) {
						serpTitleCount.textContent = 'Title: ' + tLen + ' chars (ideal 50–60, max 70)';
						serpTitleCount.className = tLen >= 45 && tLen <= 60 ? 'is-ok' : tLen <= 70 ? 'is-warn' : 'is-bad';
					}
					if (serpDescCount) {
						serpDescCount.textContent = 'Description: ' + dLen + ' chars (ideal 140–160, max 160)';
						serpDescCount.className = dLen >= 140 && dLen <= 160 ? 'is-ok' : dLen < 140 ? 'is-warn' : 'is-bad';
					}
				}

				function updateHero() {
					if (heroName) heroName.textContent = fillTokens(val('name')) || 'Brand name';
					if (heroLede) heroLede.textContent = fillTokens(val('heroLede')) || 'Agent lede';
				}

				root.querySelectorAll('.studio__serp-tab').foreach((tab) => {
					tab.addEventListener('click', () => {
						root.querySelectorAll('.studio__serp-tab').foreach((t) => t.classList.remove('is-active'));
						tab.classList.add('is-active');
						activeSerp = tab.getAttribute('data-serp') || 'home';
						updateSerp();
					});
				});

				form.addEventListener('input', (e) => {
					const t = e.target;
					if (t && t.name === 'url') {
						maybeSyncEmailFromDomain();
					}
					document.getElementById('studio-bar')?.classList.add('is-dirty');
					updateSerp();
					updateHero();
					updateThemePreview();
					updateSitemapDomain();
				});

				const urlField = form.elements.namedItem('url');
				if (urlField && 'addEventListener' in urlField) {
					urlField.addEventListener('blur', () => {
						const next = normalizeSiteUrl(val('url'));
						if (next && 'value' in urlField && urlField.value !== next) {
							urlField.value = next;
							maybeSyncEmailFromDomain();
							updateSerp();
							updateSitemapDomain();
						}
					});
				}

				document.getElementById('sync-email-btn')?.addEventListener('click', () => {
					const box = form.elements.namedItem('syncEmailToDomain');
					if (box && 'checked' in box) box.checked = true;
					syncEmailFromDomain();
					updateSerp();
					updateSitemapDomain();
				});

				document.getElementById('bump-lastmod-btn')?.addEventListener('click', () => {
					const dateEl = form.elements.namedItem('contentLastmod');
					if (dateEl && 'value' in dateEl) dateEl.value = new Date().toISOString().slice(0, 10);
				});

				function clamp01(n) {
					return Math.min(1, Math.max(0, n));
				}
				function normHex(v) {
					const t = String(v || '').trim();
					const m = t.match(/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/);
					if (!m) return null;
					let h = m[1].toLowerCase();
					if (h.length === 3) h = h.split('').map((c) => c + c).join('');
					return '#' + h;
				}
				function hexToRgb(hex) {
					const h = normHex(hex) || '#000000';
					return {
						r: parseInt(h.slice(1, 3), 16),
						g: parseInt(h.slice(3, 5), 16),
						b: parseInt(h.slice(5, 7), 16),
					};
				}
				function rgbToHex(r, g, b) {
					const to = (n) =>
						Math.round(clamp01(n / 255) * 255)
							.toString(16)
							.padStart(2, '0');
					return '#' + to(r) + to(g) + to(b);
				}
				function hexToHsl(hex) {
					const { r, g, b } = hexToRgb(hex);
					const R = r / 255,
						G = g / 255,
						B = b / 255;
					const max = Math.max(R, G, B),
						min = Math.min(R, G, B);
					const l = (max + min) / 2;
					if (max === min) return { h: 0, s: 0, l };
					const d = max - min;
					const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
					let h = 0;
					if (max === R) h = ((G - B) / d + (G < B ? 6 : 0)) / 6;
					else if (max === G) h = ((B - R) / d + 2) / 6;
					else h = ((R - G) / d + 4) / 6;
					return { h, s, l };
				}
				function hslToHex(h, s, l) {
					const H = ((h % 1) + 1) % 1;
					const S = clamp01(s);
					const L = clamp01(l);
					if (S === 0) {
						const v = L * 255;
						return rgbToHex(v, v, v);
					}
					const hue2rgb = (p, q, t) => {
						let T = t;
						if (T < 0) T += 1;
						if (T > 1) T -= 1;
						if (T < 1 / 6) return p + (q - p) * 6 * T;
						if (T < 1 / 2) return q;
						if (T < 2 / 3) return p + (q - p) * (2 / 3 - T) * 6;
						return p;
					};
					const q = L < 0.5 ? L * (1 + S) : L + S - L * S;
					const p = 2 * L - q;
					return rgbToHex(
						hue2rgb(p, q, H + 1 / 3) * 255,
						hue2rgb(p, q, H) * 255,
						hue2rgb(p, q, H - 1 / 3) * 255,
					);
				}
				function mixHex(a, b, t) {
					const A = hexToRgb(a);
					const B = hexToRgb(b);
					const u = clamp01(t);
					return rgbToHex(A.r + (B.r - A.r) * u, A.g + (B.g - A.g) * u, A.b + (B.b - A.b) * u);
				}
				function autoTones(accentIn, bgIn) {
					const accent = normHex(accentIn) || '#c026d3';
					const bg = normHex(bgIn) || '#08090a';
					const a = hexToHsl(accent);
					return {
						soft: hslToHex(a.h, clamp01(Math.min(1, a.s * 0.85)), clamp01(Math.min(0.82, Math.max(0.55, a.l + 0.22)))),
						deep: hslToHex(a.h, clamp01(Math.min(1, a.s * 1.05)), clamp01(Math.max(0.22, Math.min(0.45, a.l - 0.18)))),
						hover: hslToHex(a.h, clamp01(Math.min(1, a.s * 0.95)), clamp01(Math.min(0.72, Math.max(0.45, a.l + 0.1)))),
						panel: mixHex(bg, '#ffffff', 0.035),
					};
				}

				function colorVal(id) {
					const picker = document.getElementById('theme-' + id + '-picker');
					const text = document.getElementById('theme-' + id + '-text');
					return normHex(picker?.value) || normHex(text?.value) || null;
				}

				function setColorVal(id, hex) {
					const n = normHex(hex);
					if (!n) return;
					const picker = document.getElementById('theme-' + id + '-picker');
					const text = document.getElementById('theme-' + id + '-text');
					if (picker) picker.value = n;
					if (text) text.value = n;
				}

				function deriveTheme() {
					const accent = colorVal('accent') || '#c026d3';
					const bg = colorVal('bg') || '#08090a';
					const auto = autoTones(accent, bg);
					const soft = colorVal('soft') || auto.soft;
					const deep = colorVal('deep') || auto.deep;
					const hover = colorVal('hover') || auto.hover;
					const panel = colorVal('panel') || auto.panel;
					const bgElevated = mixHex(bg, '#ffffff', 0.07);
					const bgHover = mixHex(bg, '#ffffff', 0.1);
					const lineSoft = mixHex(bg, '#ffffff', 0.08);
					const line = mixHex(bg, '#ffffff', 0.12);
					const lineStrong = mixHex(bg, '#ffffff', 0.18);
					return {
						accent,
						bg,
						accentSoft: soft,
						accentDeep: deep,
						accentHover: hover,
						bgPanel: panel,
						bgElevated,
						bgHover,
						line,
						lineSoft,
						lineStrong,
						ink: '#f5f5f7',
						inkMuted: '#a1a1aa',
						inkFaint: '#8b8b93',
						ok: '#34d399',
						warn: '#f43f5e',
						toneVoid: mixHex(bg, '#000000', 0.35),
					};
				}

				function syncColorPair(pickerId, textId, fallback) {
					const picker = document.getElementById(pickerId);
					const text = document.getElementById(textId);
					if (!picker || !text) return;
					picker.addEventListener('input', () => {
						text.value = picker.value;
						updateThemePreview();
					});
					text.addEventListener('input', () => {
						const n = normHex(text.value);
						if (n) picker.value = n;
						updateThemePreview();
					});
					text.addEventListener('blur', () => {
						const n = normHex(text.value) || fallback;
						text.value = n;
						picker.value = n;
						updateThemePreview();
					});
				}

				function themeCssMap(t) {
					return {
						'--bg': t.bg,
						'--bg-panel': t.bgPanel,
						'--bg-elevated': t.bgElevated,
						'--bg-hover': t.bgHover,
						'--line': t.line,
						'--line-soft': t.lineSoft,
						'--line-strong': t.lineStrong,
						'--ink': t.ink,
						'--ink-muted': t.inkMuted,
						'--ink-faint': t.inkFaint,
						'--magenta': t.accent,
						'--magenta-soft': t.accentSoft,
						'--magenta-deep': t.accentDeep,
						'--accent': t.accent,
						'--accent-hover': t.accentHover,
						'--ok': t.ok,
						'--warn': t.warn,
						'--tone-void': t.toneVoid,
						'--tone-night': t.bg,
						'--tone-body': t.bg,
						'--tone-surface': t.bgPanel,
						'--accent-magenta': t.accent,
						'--accent-violet': t.accentDeep,
						'--accent-indigo': t.accent,
						'--accent-sky': t.accentSoft,
						'--accent-orange': t.accent,
						'--accent-coral': t.accent,
						'--g2a-magenta': t.accent,
						'--g2a-blue': t.accentSoft,
						'--g2a-purple': t.accentDeep,
						'--plum-link': t.accentSoft,
						'--color-violet': t.accent,
						'--color-orchid': t.accentSoft,
						'--color-midnight': t.bg,
						'--color-surface': t.bgPanel,
						'--color-border': t.line,
						'--color-ink': t.ink,
						'--color-muted': t.inkMuted,
					};
				}

				function applySitePreview(t) {
					const map = themeCssMap(t);
					const root = document.documentElement;
					Object.entries(map).foreach(([k, v]) => root.style.setProperty(k, v));

					let tag = document.getElementById('brand-theme-vars');
					if (!tag) {
						tag = document.createElement('style');
						tag.id = 'brand-theme-vars';
						document.head.appendChild(tag);
					}
					tag.textContent =
						':root,html{' +
						Object.entries(map)
							.map(([k, v]) => k + ':' + v)
							.join(';') +
						'}';

					const metaTheme = document.querySelector('meta[name="theme-color"]');
					if (metaTheme) metaTheme.setAttribute('content', t.bg);
				}

				function updateThemePreview() {
					const stage = document.getElementById('theme-stage');
					if (!stage) return;
					const t = deriveTheme();

					stage.style.background = t.bg;
					stage.style.borderColor = t.line;
					stage.style.setProperty('--theme-accent', t.accent);
					stage.style.setProperty('--theme-soft', t.accentSoft);
					stage.style.setProperty('--theme-ink', t.ink);
					stage.style.setProperty('--theme-muted', t.inkMuted);
					stage.style.setProperty('--theme-panel', t.bgPanel);
					stage.style.setProperty('--theme-line', t.line);

					const logo = document.getElementById('theme-logo');
					if (logo) logo.textContent = val('name') || 'Brand';
					const title = document.getElementById('theme-title');
					if (title) title.textContent = val('name') || 'Brand';

					applySitePreview(t);
				}

				function fillDerivedTones() {
					const accent = colorVal('accent') || '#c026d3';
					const bg = colorVal('bg') || '#08090a';
					const auto = autoTones(accent, bg);
					setColorVal('soft', auto.soft);
					setColorVal('deep', auto.deep);
					setColorVal('hover', auto.hover);
					setColorVal('panel', auto.panel);
					updateThemePreview();
				}

				['accent', 'soft', 'deep', 'hover', 'bg', 'panel'].foreach((id) => {
					const fallback =
						id === 'accent'
							? '#c026d3'
							: id === 'bg'
								? '#08090a'
								: colorVal(id) || '#888888';
					syncColorPair('theme-' + id + '-picker', 'theme-' + id + '-text', fallback);
				});

				document.getElementById('theme-derive-btn')?.addEventListener('click', fillDerivedTones);

				document.getElementById('theme-presets')?.addEventListener('click', (e) => {
					const btn = e.target.closest('.studio__theme-preset');
					if (!btn) return;
					const accent = btn.getAttribute('data-accent');
					const bg = btn.getAttribute('data-bg');
					if (accent) setColorVal('accent', accent);
					if (bg) setColorVal('bg', bg);
					fillDerivedTones();
					document.querySelectorAll('.studio__theme-preset').foreach((el) => el.classList.remove('is-active'));
					btn.classList.add('is-active');
				});

				updateThemePreview();

