		name: 'logoRasterWidth',
		label: 'Logo width (px)',
		tip: 'What: Raster logo pixel width. | Why: Schema ImageObject. | Example: 512',
		value: brand.logoRasterWidth,
		type: 'number',
		min: 16,
		max: 4096,
	},
	{
		name: 'logoRasterHeight',
		label: 'Logo height (px)',
		tip: 'What: Raster logo pixel height. | Why: Schema ImageObject. | Example: 512',
		value: brand.logoRasterHeight,
		type: 'number',
		min: 16,
		max: 4096,
	},
	{
		name: 'defaultOgImage',
		label: 'Default OG image',
		tip: 'What: Default image when the site is shared on Discord / Twitter / Facebook. | Why: Open Graph preview. Put a real in-game or brand shot under /images/. | Example: /images/fortnite-combat.webp',
		value: brand.defaultOgImage,
		maxlength: 300,
	},
	{
		name: 'heroImage',
		label: 'Agent image',
		tip: 'What: Big homepage banner image path. | Why: First thing visitors see. Keep file in /public/images/. | Example: /images/fortnite-hero-banner.webp',
		value: brand.heroImage,
		maxlength: 300,
	},
];

const sitemapMetaFields: Field[] = [
	{
		name: 'contentLastmod',
		label: 'Content lastmod (YYYY-MM-DD)',
		tip: 'What: Brand-level sitemap date. | Why: When this is newer than a page date, sitemaps use it so Google sees a refresh after rebrand. | Example: 2026-08-10',
		value: sitemap.contentLastmod,
		maxlength: 12,
		placeholder: '2026-08-10',
	},
	{
		name: 'blogImageTitle',
		label: 'Blog sitemap image title',
		tip: 'What: Title for the blog index image in sitemaps. | Why: Image sitemap / urlset labels. Tokens work. | Example: {brand} blog',
		value: sitemap.blogImageTitle,
		maxlength: 160,
	},
	{
		name: 'blogImageCaption',
		label: 'Blog sitemap image caption',
		tip: 'What: Caption under the blog index image. | Why: Helps image search context. | Example: {game} tips and {antiCheat} notes',
		value: sitemap.blogImageCaption,
		maxlength: 220,
		span: true,
	},
	{
		name: 'reviewsImageTitle',
		label: 'Reviews sitemap image title',
		tip: 'What: Title for the reviews index image. | Why: EN reviews urlset image label. | Example: {brand} reviews',
		value: sitemap.reviewsImageTitle,
		maxlength: 160,
	},
	{
		name: 'reviewsImageCaption',
		label: 'Reviews sitemap image caption',
		tip: 'What: Caption for reviews image. | Why: EN reviews urlset. | Example: What buyers say about {primaryKeyword}',
		value: sitemap.reviewsImageCaption,
		maxlength: 220,
		span: true,
	},
];

const seoCoreFields = seoFields.filter((f) =>
	/^(home|features|store|status|preview)(Title|Description)$/.test(f.name),
);
const seoMoreFields = seoFields.filter((f) =>
	/^(setup|support|faq|reviews|blog)(Title|Description)$/.test(f.name),
);

const seoAuditRows = [
	{ page: 'Home', path: '/', fields: 'homeTitle / homeDescription', status: 'Live · permanent' },
	{ page: 'Features', path: '/features/', fields: 'featuresTitle / Description + intro', status: 'Live · permanent' },
	{ page: 'Store', path: '/pricing/', fields: 'storeTitle / Description + intro', status: 'Live · permanent' },
	{ page: 'Status', path: '/updates/', fields: 'statusTitle / Description + intro', status: 'Live · permanent' },
	{ page: 'Preview', path: '/warzone-cheats/', fields: 'previewTitle / Description + intro', status: 'Live · permanent' },
	{ page: 'Setup', path: '/setup/', fields: 'setupTitle / Description + intro', status: 'Live · permanent' },
	{ page: 'Support', path: '/support/', fields: 'supportTitle / Description + intro', status: 'Live · permanent' },
	{ page: 'FAQ index', path: '/faq/', fields: 'faqTitle / Description + intro', status: 'Live · permanent' },
	{ page: 'Reviews index', path: '/reviews/', fields: 'reviewsTitle / Description + intro', status: 'Live · permanent' },
	{ page: 'Blog index', path: '/blog/', fields: 'blogTitle / blogDescription', status: 'Live · EN permanent' },
	{ page: 'Keyword landings', path: '/warzone-esp/ …', fields: 'content.generated.ts', status: 'Manual file' },
	{ page: 'FAQ answers', path: '/faq/[slug]/', fields: 'site.ts faqs', status: 'Manual file' },
	{ page: 'Review posts', path: '/reviews/[slug]/', fields: 'site.ts reviews', status: 'Manual file' },
] as const;

const sections = [
	{ id: 'identity', label: 'Identity', hint: '1', desc: 'Brand name, domain, and support contact.' },
	{ id: 'product', label: 'Product', hint: '2', desc: 'Game, anti-cheat, platforms, and pricing.' },
	{ id: 'colors', label: 'Colors', hint: '3', desc: 'Accent, soft, deep, hover, canvas, panel.' },
	{ id: 'seo', label: 'SEO', hint: '4', desc: 'Page titles and meta descriptions for Google.' },
	{ id: 'keywords', label: 'Keywords', hint: '5', desc: 'Primary phrase and related search terms.' },
	{ id: 'copy', label: 'Copy', hint: '6', desc: 'Homepage tagline, summary, and agent text.' },
	{ id: 'images', label: 'Images', hint: '7', desc: 'Logo, OG, and agent asset paths.' },
	{ id: 'sitemap', label: 'Sitemap', hint: '8', desc: 'Domain-locked URLs + optional labels.' },
] as const;
---

<Layout title={title} description={description} noindex={true} canonicalPath="/brand-studio/">
	<main class="studio">
		{
			isDev ? (
				<div class="studio__shell" id="studio-root">
					<header class="studio__head">
						<p class="studio__eyebrow">Localhost · permanent writes to brand.ts</p>
						<h1>Brand Studio</h1>
						<p class="studio__lede">
							Rebrand identity, SEO, colors, and assets in one place. Every Save writes{' '}
							<code>src/data/brand.ts</code> and syncs domain / robots. Hover{' '}
							<span class="studio__q-demo" aria-hidden="true">?</span> for field help.
						</p>
						<ol class="studio__checklist">
							<li><a href="#section-identity">1. Identity + domain</a></li>
							<li><a href="#section-product">2. Product</a></li>
							<li><a href="#section-seo">3. SEO titles</a></li>
							<li><a href="#section-copy">4. Page copy</a></li>
							<li><a href="#section-colors">5. Colors</a></li>
							<li><strong>6. Save</strong> (Ctrl+S)</li>
						</ol>
						<p class="studio__scope">
							<strong>Permanent in Studio:</strong> EN hub pages (Home, Features, Store, Status, Preview,
							Setup, Support, FAQ, Reviews, Blog), nav, hero, theme, sitemap labels, domain.
							<strong> Still manual after rebrand:</strong> keyword landing bodies in
							<code>content.generated.ts</code>, FAQ/review item text in <code>site.ts</code>.
						</p>
					</header>

					<div class="studio__layout">
						<nav class="studio__nav" aria-label="Sections">
							<ul>
								{sections.map((s) => (
									<li>
										<a href={`#section-${s.id}`} data-section={s.id}>
											<span>{s.label}</span>
											<kbd>{s.hint}</kbd>
										</a>
									</li>
								))}
							</ul>
						</nav>

						<div class="studio__main">
							<form class="studio__form" id="studio-form" autocomplete="off">
								<section class="studio__block" id="section-identity">
									<h2>Identity</h2>
									<p class="studio__block-desc">
										Brand name, domain, and support contact. Change <strong>Site URL</strong> once —
										sitemaps and robots follow it automatically.
									</p>
									<div class="studio__row-actions">
										<button type="button" class="studio__mini" id="sync-short-btn">
											Sync short name
										</button>
										<button type="button" class="studio__mini" id="sync-email-btn">
											Match email to domain
										</button>
									</div>
									<div class="studio__grid">
										{identity.map((f) => (
											<label class:list={['studio__field', f.span && 'is-span']}>
												<span class="studio__lab">
													{f.label}
													<button type="button" class="studio__q" aria-label={`Help: ${f.label}`} data-tip={f.tip}>?</button>
												</span>
												{f.textarea ? (
													<textarea name={f.name} rows={f.rows ?? 4} required={f.required} maxlength={f.maxlength} placeholder={f.placeholder}>{f.value}</textarea>
												) : (
													<input name={f.name} type={f.type ?? 'text'} required={f.required} maxlength={f.maxlength} min={f.min} max={f.max} step={f.type === 'number' ? 1 : undefined} value={f.value} placeholder={f.placeholder} />
												)}
											</label>
										))}
										<label class="studio__field is-span studio__check">
											<span class="studio__lab">
												Keep support email matched to domain
												<button
													type="button"
													class="studio__q"
													aria-label="Help: Match email"
													data-tip="What: When Site URL changes, set support@yourdomain automatically. | Why: One less field to fix on rebrand. | Example: https://apexcheats.com → support@apexcheats.com"
												>
													?
												</button>
											</span>
											<input name="syncEmailToDomain" type="checkbox" value="1" checked />
										</label>
									</div>
									<p class="studio__domain-live" id="identity-domain-live" aria-live="polite">
										Sitemap / robots will use: <code id="identity-domain-code">{brand.url}/sitemap.xml</code>
									</p>
								</section>

								<section class="studio__block" id="section-product">
									<h2>Product</h2>
									<p class="studio__block-desc">Game, anti-cheat, platforms, and pricing.</p>
									<div class="studio__grid">
										{product.map((f) => (
											<label class:list={['studio__field', f.span && 'is-span']}>
												<span class="studio__lab">
													{f.label}
													<button type="button" class="studio__q" aria-label={`Help: ${f.label}`} data-tip={f.tip}>?</button>
												</span>
												{f.textarea ? (
													<textarea name={f.name} rows={f.rows ?? 4} required={f.required} maxlength={f.maxlength}>{f.value}</textarea>
												) : (
													<input name={f.name} type={f.type ?? 'text'} required={f.required} maxlength={f.maxlength} min={f.min} max={f.max} step={f.type === 'number' ? 1 : undefined} value={f.value} />
												)}
											</label>
										))}
									</div>
								</section>

								<section class="studio__block studio__block--colors" id="section-colors">
									<h2>Colors</h2>
									<p class="studio__block-desc">
										Every tone is editable. Soft / deep / hover / panel start from accent + canvas, then you
										can override them. Save writes all six into <code>brand.theme</code>.
									</p>

									<div class="studio__theme" id="color-preview">
										<div class="studio__theme-stage" id="theme-stage">
											<div class="studio__theme-nav">
												<span class="studio__theme-logo" id="theme-logo">{brand.name}</span>
												<span class="studio__theme-nav-link">Features</span>
												<span class="studio__theme-nav-link is-active">Store</span>
												<span class="studio__theme-pill" id="theme-pill">Buy</span>
											</div>
											<div class="studio__theme-hero">
												<p class="studio__theme-kicker" id="theme-kicker">Accent preview</p>
												<p class="studio__theme-title" id="theme-title">{brand.name}</p>
												<p class="studio__theme-lede" id="theme-lede">
													Links use soft. Buttons use accent. Panels use panel.
												</p>
												<div class="studio__theme-actions">
													<span class="studio__theme-cta" id="theme-cta">Buy now</span>
													<a class="studio__theme-link" id="theme-link" href="/" target="_blank" rel="noopener">
														Open live site
													</a>
												</div>
											</div>
										</div>

										<div class="studio__row-actions">
											<button type="button" class="studio__mini" id="theme-derive-btn">
												Re-derive soft / deep / hover / panel
											</button>
										</div>

										<div class="studio__theme-controls studio__theme-controls--six">
											{
												[
													{
														id: 'accent',
														name: 'themeaccent',
														label: 'Accent',
														tip: 'What: Main brand color. | Why: CTAs, focus, highlights. | Example: #ff4655',
														value: theme.accent,
													},
													{
														id: 'soft',
														name: 'themeSoft',
														label: 'Soft',
														tip: 'What: Lighter accent for links and labels. | Why: --magenta-soft site-wide. | Example: #ffa0a8',
														value: theme.accentSoft,
													},
													{
														id: 'deep',
														name: 'themeDeep',
														label: 'Deep',
														tip: 'What: Darker accent for depth. | Why: --magenta-deep. | Example: #9a1f2a',
														value: theme.accentDeep,
													},
													{
														id: 'hover',
														name: 'themeHover',
														label: 'Hover',
														tip: 'What: Accent hover state. | Why: --accent-hover on interactive elements. | Example: #ff6b75',
														value: theme.accentHover,
													},
													{
														id: 'bg',
														name: 'themeBg',
														label: 'Canvas',
														tip: 'What: Page background. | Why: --bg and browser theme-color. Keep near-black. | Example: #08090a',
														value: theme.bg,
													},
													{
														id: 'panel',
														name: 'themePanel',
														label: 'Panel',
														tip: 'What: Card / section surface. | Why: --bg-panel. | Example: #12141a',
														value: theme.bgPanel,
													},
												].map((f) => (
													<label class="studio__theme-field">
														<span class="studio__theme-field-lab">
															{f.label}
															<button
																type="button"
																class="studio__q"
																aria-label={`Help: ${f.label}`}
																data-tip={f.tip}
															>
																?
															</button>
														</span>
														<div class="studio__theme-well">
															<input
																name={f.name}
																type="color"
																value={f.value}
																id={`theme-${f.id}-picker`}
															/>
															<input
																name={`${f.name}Text`}
																type="text"
																maxlength={7}
																value={f.value}
																id={`theme-${f.id}-text`}
																spellcheck="false"
																autocomplete="off"
																aria-label={`${f.label} hex`}
															/>
														</div>
													</label>
												))
											}
										</div>

										<p class="studio__presets-label">Presets</p>
										<div class="studio__theme-presets" id="theme-presets">
											{themePresets.map((p) => (
												<button
													type="button"
													class="studio__theme-preset"
													data-accent={p.accent}
													data-bg={p.bg}
													aria-label={p.label}
													title={p.label}
												>
													<span class="studio__theme-preset-swatch" style={`background:${p.accent}`} />
													<span class="studio__theme-preset-bg" style={`background:${p.bg}`} />
													<span class="studio__theme-preset-name">{p.label}</span>
												</button>
											))}
										</div>
									</div>
								</section>

<section class="studio__block studio__block--seo" id="section-seo">
									<h2>SEO</h2>
									<p class="studio__block-desc">
										Google titles (max 70) and descriptions (max 160) for every hub page. SERP preview
										matches live clamps. Save writes permanently — long text is truncated with a
										warning, never silently reverted. Yellow rows in the audit still need manual file
										edits.
									</p>

									<div class="studio__audit">
										<p class="studio__audit-title">SEO coverage audit</p>
										<table class="studio__audit-table">
											<thead>
												<tr>
													<th>Page</th>
													<th>URL</th>
													<th>Brand fields</th>
													<th>Status</th>
												</tr>
											</thead>
											<tbody>
												{seoAuditRows.map((row) => (
													<tr>
														<td>{row.page}</td>
														<td>
															<a href={row.path} target="_blank" rel="noopener">
																{row.path}
															</a>
														</td>
														<td>{row.fields}</td>
														<td>
															<span
																class:list={[
																	'studio__audit-status',
																	row.status.includes('Manual')
																		? 'is-manual'
																		: 'is-live',
																]}
															>
																{row.status}
															</span>
														</td>
													</tr>
												))}
											</tbody>
										</table>
									</div>

									<div class="studio__previews">
										<div class="studio__serp">
											<div class="studio__serp-tabs" role="tablist" aria-label="SERP preview page">
												{[
													'home',
													'features',
													'store',
													'status',
													'preview',
													'setup',
													'support',
													'faq',
													'reviews',
													'blog',
												].map((id, i) => (
													<button
														type="button"
														class:list={['studio__serp-tab', i === 0 && 'is-active']}
														data-serp={id}
													>
														{id.charAt(0).toUpperCase() + id.slice(1)}
													</button>
												))}
											</div>
											<div class="studio__serp-card">
												<p class="studio__serp-url" id="serp-url">
													{brand.url.replace(/^https?:\/\//, '')}
												</p>
												<p class="studio__serp-title" id="serp-title">
													{seo.homeTitle}
												</p>
												<p class="studio__serp-desc" id="serp-desc">
													{seo.homeDescription}
												</p>
											</div>
											<div class="studio__serp-counts">
												<span id="serp-title-count">Title: 0 chars</span>
												<span id="serp-desc-count">Description: 0 chars</span>
											</div>
										</div>

										<div class="studio__hero-preview">
											<p class="studio__hero-preview-label">Agent preview</p>
											<p class="studio__hero-preview-body">
												<strong id="hero-preview-name">{brand.name}</strong>
												<span id="hero-preview-lede">{copy.heroLede}</span>
											</p>
										</div>
									</div>

									<div class="studio__tokens">
										<span class="studio__tokens-label">Insert token:</span>
										<button type="button" class="studio__chip" data-token="{brand}">
											{'{brand}'}
										</button>
										<button type="button" class="studio__chip" data-token="{game}">
											{'{game}'}
										</button>
										<button type="button" class="studio__chip" data-token="{antiCheat}">
											{'{antiCheat}'}
										</button>
										<button type="button" class="studio__chip" data-token="{email}">
											{'{email}'}
										</button>
										<button type="button" class="studio__chip" data-token="{primaryKeyword}">
											{'{primaryKeyword}'}
										</button>
									</div>

									<div class="studio__row-actions">
										<button type="button" class="studio__mini" id="autofill-seo-btn">
											Autofill SEO
										</button>
									</div>

									<h3 class="studio__subhead">Core pages</h3>
									<p class="studio__block-desc">Home + Preview / Features / Store / Status.</p>
									<div class="studio__grid">
										{seoCoreFields.map((f) => (
											<label class:list={['studio__field', f.span && 'is-span']}>
												<span class="studio__lab">
													{f.label}
													<button type="button" class="studio__q" aria-label={`Help: ${f.label}`} data-tip={f.tip}>
														?
													</button>
												</span>
												{f.textarea ? (
													<textarea name={f.name} rows={f.rows ?? 2} required={f.required} maxlength={f.maxlength}>{f.value}</textarea>
												) : (
													<input name={f.name} type="text" required={f.required} maxlength={f.maxlength} value={f.value} />
												)}
											</label>
										))}
									</div>

									<h3 class="studio__subhead">More pages</h3>
									<p class="studio__block-desc">Setup, Support, FAQ, Reviews, Blog.</p>
									<div class="studio__grid">
										{seoMoreFields.map((f) => (
											<label class:list={['studio__field', f.span && 'is-span']}>
												<span class="studio__lab">
													{f.label}
													<button type="button" class="studio__q" aria-label={`Help: ${f.label}`} data-tip={f.tip}>
														?
													</button>
												</span>
												{f.textarea ? (
													<textarea name={f.name} rows={f.rows ?? 2} required={f.required} maxlength={f.maxlength}>{f.value}</textarea>
												) : (
													<input name={f.name} type="text" required={f.required} maxlength={f.maxlength} value={f.value} />
												)}
											</label>
										))}
									</div>
								</section>

								<section class="studio__block" id="section-keywords">
									<h2>Keywords</h2>
									<p class="studio__block-desc">Primary phrase and related search terms.</p>
									<div class="studio__row-actions">
										<button type="button" class="studio__mini" id="add-primary-btn">
											Add primary to list
										</button>
									</div>
									<div class="studio__grid">
										{keywords.map((f) => (
											<label class:list={['studio__field', f.span && 'is-span']}>
												<span class="studio__lab">
													{f.label}
													<button type="button" class="studio__q" aria-label={`Help: ${f.label}`} data-tip={f.tip}>?</button>
												</span>
												{f.textarea ? (
													<textarea name={f.name} rows={f.rows ?? 4} required={f.required} maxlength={f.maxlength}>{f.value}</textarea>
												) : (
													<input name={f.name} type="text" required={f.required} maxlength={f.maxlength} value={f.value} />
												)}
											</label>
										))}
									</div>
								</section>

								<section class="studio__block" id="section-copy">
									<h2>Copy</h2>
									<p class="studio__block-desc">Homepage tagline, summary, and agent text.</p>
									<div class="studio__grid">
										{copyFields.map((f) => (
											<label class:list={['studio__field', f.span && 'is-span']}>
