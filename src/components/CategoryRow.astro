---
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getForumBasePath } from '../data/forums/helpers';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
	/** Skip inner .shell when already inside a padded container (e.g. blog index). */
	embedded?: boolean;
}

const locale = Astro.props.locale ?? defaultLocale;
const embedded = Astro.props.embedded ?? false;
const t = getT(locale);

const categories = [
	{ label: t('categoryRow.hacks'), href: getLocalizedPath('hacks', locale) },
	{ label: t('categoryRow.esp'), href: getLocalizedPath('warzone-esp', locale) },
	{ label: t('categoryRow.aimbot'), href: getLocalizedPath('warzone-aimbot', locale) },
	{ label: t('categoryRow.radar'), href: getLocalizedPath('radar', locale) },
	{ label: t('categoryRow.features'), href: getLocalizedPath('features', locale) },
	{ label: t('categoryRow.wallhack'), href: getLocalizedPath('warzone-esp', locale) },
	{ label: t('categoryRow.pricing'), href: getLocalizedPath('pricing', locale) },
	{ label: t('categoryRow.setup'), href: getLocalizedPath('setup', locale) },
	{ label: t('categoryRow.forums'), href: getForumBasePath(locale) },
];
---

<nav class="cats" aria-label={t('common.browse')}>
	{
		embedded ? (
			<ul class="cats__list">
				{
					categories.map((cat) => (
						<li>
							<a href={cat.href}>{cat.label}</a>
						</li>
					))
				}
			</ul>
		) : (
			<div class="shell">
				<ul class="cats__list">
					{
						categories.map((cat) => (
							<li>
								<a href={cat.href}>{cat.label}</a>
							</li>
						))
					}
				</ul>
			</div>
		)
	}
</nav>

<style>
	.cats {
		border-block: 1px solid var(--line-soft);
		background: var(--bg-panel);
	}

	.cats__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 1rem 0;
		list-style: none;
	}

	.cats__list a {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-pill);
		background: var(--bg-elevated);
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--ink-muted);
		white-space: nowrap;
		transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
	}

	.cats__list a:hover {
		color: var(--ink);
		border-color: color-mix(in srgb, var(--magenta) 45%, var(--line));
		background: color-mix(in srgb, var(--magenta) 10%, var(--bg-elevated));
	}

	@media (max-width: 720px) {
		.cats {
			margin-inline: calc(-1 * var(--page-gutter));
			border-inline: none;
		}

		.cats__list {
			flex-wrap: nowrap;
			justify-content: flex-start;
			gap: 0.45rem;
			padding: 0.85rem var(--page-gutter);
			overflow-x: auto;
			overflow-y: hidden;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.cats__list::-webkit-scrollbar {
			display: none;
		}

		.cats__list li {
			flex: 0 0 auto;
		}

		.cats__list a {
			min-height: var(--touch-min, 2.75rem);
			padding-inline: 1rem;
		}
	}
</style>
