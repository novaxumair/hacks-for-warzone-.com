---
import SiteFooterApp from './react/SiteFooter';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getForumBasePath } from '../data/forums/helpers';
import { siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;

const explore = [
	{ labelKey: 'nav.hacks', href: getLocalizedPath('home', locale) },
	{ labelKey: 'nav.esp', href: getLocalizedPath('warzone-esp', locale) },
	{ labelKey: 'nav.aimbot', href: getLocalizedPath('warzone-aimbot', locale) },
	{ labelKey: 'common.featureList', href: getLocalizedPath('features', locale) },
	{ labelKey: 'common.pricingPlans', href: getLocalizedPath('pricing', locale) },
	{ labelKey: 'nav.faq', href: getLocalizedPath('faq', locale) },
	{ labelKey: 'common.forums', href: getForumBasePath(locale) },
];

const help = [
	{ labelKey: 'nav.setup', href: getLocalizedPath('setup', locale) },
	{ labelKey: 'nav.updates', href: getLocalizedPath('updates', locale) },
	{ labelKey: 'common.buyerReviewsNav', href: '/reviews/' },
	{ labelKey: 'common.support', href: getLocalizedPath('support', locale) },
	{ labelKey: 'common.refundPolicy', href: getLocalizedPath('refund', locale) },
	{ labelKey: 'common.privacy', href: getLocalizedPath('privacy', locale) },
	{ labelKey: 'common.terms', href: getLocalizedPath('terms', locale) },
];
---

<SiteFooterApp
	client:visible
	locale={locale}
	siteName={siteConfig.name}
	supportEmail={siteConfig.supportEmail}
	shareUrl={`${siteConfig.url}/`}
	explore={explore}
	help={help}
/>

<style is:global>
	.site-footer {
		background: color-mix(in srgb, var(--bg-panel) 92%, transparent);
		border-top: 1px solid color-mix(in srgb, var(--magenta-deep) 18%, var(--line-soft));
		padding-top: 3rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 360px;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr;
		gap: 2rem;
		padding-bottom: 2.25rem;
	}

	.site-footer__brand {
		display: block;
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.site-footer__share-label {
		margin: 1.1rem 0 0.45rem !important;
		font-size: 0.75rem !important;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint) !important;
	}

	.site-footer__share {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
	}

	.site-footer__share a {
		font-size: 0.85rem;
		color: var(--ink-muted);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.site-footer__share a:hover {
		color: var(--accent-hover);
	}

	.site-footer p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-faint);
		max-width: 20rem;
	}

	.site-footer__label {
		margin: 0 0 0.85rem !important;
		font-size: 0.75rem !important;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted) !important;
	}

	.site-footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.site-footer a:not(.site-footer__brand) {
		font-size: 0.875rem;
		color: var(--ink-muted);
	}

	.site-footer a:not(.site-footer__brand):hover {
		color: var(--ink);
	}

	.site-footer__bottom {
		border-top: 1px solid var(--line-soft);
		padding: 1.1rem 0 1.6rem;
	}

	.site-footer__bottom p {
		max-width: none;
		font-size: 0.75rem;
	}

	@media (max-width: 760px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.site-footer a:not(.site-footer__brand) {
			display: inline-flex;
			align-items: center;
			min-height: var(--touch-min, 2.75rem);
			overflow-wrap: anywhere;
		}

		.site-footer__bottom {
			padding-bottom: max(1.35rem, var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
		}
	}
</style>
