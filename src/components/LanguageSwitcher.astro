---
import { locales, type LocaleCode } from '../data/i18n/locales';
import {
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { getForumLocaleSwitchHref, isForumPath } from '../data/forums/helpers';

interface Props {
	pageId?: PageId;
	currentLocale: LocaleCode;
}

const { pageId: pageIdFallback, currentLocale } = Astro.props;
const pathname = Astro.url.pathname;
const onBlog = isForumPath(pathname);
const onReviews = pathname.startsWith('/reviews');
const pathContext = resolvePageContextFromPath(pathname);
const pageContext = onBlog
	? pathContext
	: onReviews
		? pathContext
		: {
				...pathContext,
				pageId: pathContext.pageId ?? pageIdFallback ?? 'home',
			};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onBlog) {
		return getForumLocaleSwitchHref(pathname, targetLocale);
	}
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const currentMeta = locales.find((l) => l.code === currentLocale)!;
---

<details class="lang-switcher">
	<summary class="lang-switcher__toggle" aria-label="Select language">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle>
			<path
				d="M3 12h18M12 3c2.5 2.8 3.8 6 3.8 9s-1.3 6.2-3.8 9M12 3c-2.5 2.8-3.8 6-3.8 9s1.3 6.2 3.8 9"
				stroke="currentColor"
				stroke-width="1.6"></path>
		</svg>
		<span>{currentMeta.nativeName}</span>
	</summary>
	<div class="lang-switcher__panel">
		<p class="lang-switcher__note">
			{currentLocale === 'en' ? 'English — official language' : `English is the official language`}
		</p>
		<ul class="lang-switcher__list">
			{
				locales.map((locale) => {
					const href = localeSwitchHref(locale.code);
					const isCurrent = locale.code === currentLocale;
					return (
						<li>
							<a
								href={href}
								hreflang={locale.hreflang}
								lang={locale.code}
								class:list={['lang-switcher__link', { 'is-current': isCurrent }]}
								aria-current={isCurrent ? 'page' : undefined}
								data-locale={locale.code}
							>
								<span class="lang-switcher__native">{locale.nativeName}</span>
								<span class="lang-switcher__region">{locale.region}</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</details>

<style>
	.lang-switcher {
		position: relative;
	}

	.lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--color-border);
		background: transparent;
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 500;
		cursor: pointer;
		list-style: none;
	}

	.lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.lang-switcher__panel {
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		z-index: 90;
		width: min(16rem, calc(100vw - 2rem));
		max-height: min(20rem, 70vh);
		overflow-y: auto;
		padding: 0.5rem;
		border: 1px solid var(--color-border);
		background: var(--color-midnight);
	}

	.lang-switcher__note {
		margin: 0 0 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.55rem;
		background: var(--g2a-gray-50);
		color: var(--color-muted);
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.25rem;
	}

	.lang-switcher__link {
		display: grid;
		gap: 0.1rem;
		padding: 0.55rem 0.65rem;
		border-radius: 0.55rem;
		color: var(--color-ink);
		transition: background 0.15s ease;
	}

	.lang-switcher__link:hover,
	.lang-switcher__link.is-current {
		background: var(--g2a-gray-50);
	}

	.lang-switcher__native {
		font-size: 0.86rem;
		font-weight: 700;
	}

	.lang-switcher__region {
		font-size: 0.68rem;
		color: var(--color-faint);
	}

	@media (max-width: 1024px) {
		.lang-switcher__panel {
			position: fixed;
			left: max(var(--page-gutter), var(--safe-left, 0px));
			right: max(var(--page-gutter), var(--safe-right, 0px));
			width: auto;
			max-height: min(70dvh, 24rem);
			overflow: auto;
		}
	}
</style>

<script>
	document.querySelectorAll('.lang-switcher__link[data-locale]').foreach((link) => {
		link.addEventListener('click', () => {
			const code = link.getAttribute('data-locale');
			if (code) {
				document.cookie = `vc_locale=${code};path=/;max-age=31536000;SameSite=Lax`;
			}
		});
	});
</script>
