---
import { getFeaturedThreads, getForumBasePath } from '../data/forums/helpers';
import type { LocaleCode } from '../data/i18n/locales';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const featured = getFeaturedThreads(locale, 3);
const forumHref = getForumBasePath(locale);
---

<section class="home-forums shell" aria-labelledby="home-forums-title">
	<header class="home-forums__head">
		<p class="home-forums__eyebrow">Community</p>
		<h2 id="home-forums-title">Forum highlights</h2>
		<p class="home-forums__lede">
			Players share aimbot configs, ESP setups, and post-patch checklists. Preview threads below — full reply access after license activation.
		</p>
	</header>

	<ul class="home-forums__list">
		{
			featured.map((thread) => {
				const replyCount = thread.translation.comments.length;
				return (
					<li>
						<a class="home-forums__card" href={thread.canonicalPath}>
							<div class="home-forums__reply" aria-hidden="true">
								<span class="home-forums__reply-count">{replyCount}</span>
								<span class="home-forums__reply-label">Replies</span>
							</div>
							<div class="home-forums__body">
								<span class="home-forums__cat">{thread.category}</span>
								<strong>{thread.translation.title}</strong>
								<p class="home-forums__excerpt">{thread.translation.intro}</p>
								<span class="home-forums__meta">
									{replyCount} {replyCount === 1 ? 'reply' : 'replies'} · Updated {thread.updated}
								</span>
							</div>
						</a>
					</li>
				);
			})
		}
	</ul>

	<div class="home-forums__actions">
		<a class="home-forums__browse btn-primary" href={forumHref}>Browse all forums</a>
	</div>
</section>

<style>
	.home-forums {
		padding-block: clamp(2rem, 4vw, 3rem);
		border-top: 1px solid color-mix(in srgb, var(--magenta) 6%, var(--line-soft));
	}

	.home-forums__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: color-mix(in srgb, var(--magenta-soft) 72%, var(--ink-muted));
	}

	.home-forums__head h2 {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3vw, 2rem);
		color: var(--ink-heading);
	}

	.home-forums__lede {
		max-width: 38rem;
		margin: 0 0 1.75rem;
		color: var(--ink-muted);
		line-height: 1.65;
	}

	.home-forums__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.home-forums__card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 100%;
		border: 1px solid color-mix(in srgb, var(--magenta) 12%, var(--line-strong));
		border-radius: var(--radius-md);
		background:
			linear-gradient(145deg, color-mix(in srgb, var(--magenta) 4%, var(--bg-panel)), var(--bg-panel));
		text-decoration: none;
		color: inherit;
		overflow: hidden;
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--magenta) 3%, transparent) inset,
			0 8px 22px rgba(0, 0, 0, 0.32);
		transition:
			border-color 0.22s ease,
			box-shadow 0.22s ease,
			transform 0.22s ease;
	}

	.home-forums__card:hover {
		border-color: color-mix(in srgb, var(--magenta) 22%, var(--line-strong));
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--magenta) 6%, transparent) inset,
			0 10px 26px rgba(0, 0, 0, 0.38),
			0 0 18px color-mix(in srgb, var(--magenta-deep) 8%, transparent);
		transform: translateY(-2px);
	}

	.home-forums__reply {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid color-mix(in srgb, var(--magenta) 8%, var(--line-strong));
		background: color-mix(in srgb, var(--magenta) 4%, var(--bg-panel));
	}

	.home-forums__reply-count {
		font-family: var(--font-display);
		font-size: 1.65rem;
		font-weight: 800;
		line-height: 1;
		color: color-mix(in srgb, var(--magenta-soft) 78%, var(--ink-muted));
	}

	.home-forums__reply-label {
		font-size: 0.62rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-faint);
	}

	.home-forums__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.35rem;
		padding: 1rem 1.1rem 1.05rem;
	}

	.home-forums__cat {
		display: inline-flex;
		align-self: flex-start;
		padding: 0.2rem 0.5rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--magenta) 18%, var(--line-strong));
		background: color-mix(in srgb, var(--magenta) 6%, transparent);
		font-size: 0.66rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: color-mix(in srgb, var(--magenta-soft) 75%, var(--ink-muted));
	}

	.home-forums__body strong {
		font-family: var(--font-display);
		font-size: 1.08rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--ink-heading);
	}

	.home-forums__excerpt {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.88rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.home-forums__meta {
		margin-top: auto;
		padding-top: 0.65rem;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--ink-faint);
	}

	.home-forums__actions {
		display: flex;
		justify-content: center;
		margin-top: 1.75rem;
	}

	.home-forums__browse {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0 1.5rem;
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-decoration: none;
	}

	@media (max-width: 960px) {
		.home-forums__list {
			grid-template-columns: 1fr;
		}

		.home-forums__card {
			flex-direction: row;
		}

		.home-forums__reply {
			flex-direction: column;
			justify-content: center;
			width: 5rem;
			padding: 1rem 0.75rem;
			border-bottom: none;
			border-right: 1px solid color-mix(in srgb, var(--magenta) 8%, var(--line-strong));
		}
	}
</style>
