---
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);

const items = [
	{
		tone: 'teal',
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 3.5l7 3v5.5c0 4.2-2.8 7.8-7 9.5-4.2-1.7-7-5.3-7-9.5V6.5l7-3z" stroke="currentColor" stroke-width="1.6"/></svg>`,
		label: t('product.statusBadge'),
	},
	{
		tone: 'amber',
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
		label: t('trustStrip.instantDelivery'),
	},
	{
		tone: 'indigo',
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.6"/></svg>`,
		label: t('trustStrip.secureCheckout'),
	},
	{
		tone: 'coral',
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 8v4l2.5 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
		label: t('trustStrip.support247'),
	},
];
---

<div class="g2a-band g2a-band--warm g2a-trust-bar">
	<div class="shell g2a-trust" role="list">
		{
			items.map((item) => (
				<div class="g2a-trust__item" role="listitem">
					<span class:list={['g2a-trust__icon', `g2a-trust__icon--${item.tone}`]} set:html={item.icon} />
					<span>{item.label}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.g2a-trust-bar {
		padding-block: 0.85rem;
	}

	.g2a-trust {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		align-items: center;
	}

	.g2a-trust__item {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--g2a-gray-600);
		text-align: center;
		min-width: 0;
	}

	.g2a-trust__icon {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 8px;
		background: var(--tone-raised);
		border: 1px solid var(--tone-border-soft);
		flex-shrink: 0;
	}

	.g2a-trust__icon--teal {
		color: var(--accent-teal);
		background: rgba(45, 212, 191, 0.1);
		border-color: rgba(45, 212, 191, 0.22);
	}

	.g2a-trust__icon--amber {
		color: var(--accent-amber);
		background: rgba(251, 191, 36, 0.1);
		border-color: rgba(251, 191, 36, 0.22);
	}

	.g2a-trust__icon--indigo {
		color: var(--accent-indigo);
		background: rgba(99, 102, 241, 0.1);
		border-color: rgba(99, 102, 241, 0.22);
	}

	.g2a-trust__icon--coral {
		color: var(--accent-coral);
		background: rgba(249, 115, 22, 0.1);
		border-color: rgba(249, 115, 22, 0.22);
	}

	@media (max-width: 900px) {
		.g2a-trust {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem 1rem;
		}

		.g2a-trust__item {
			justify-content: flex-start;
		}
	}

	@media (max-width: 480px) {
		.g2a-trust {
			grid-template-columns: 1fr;
		}
	}
</style>
