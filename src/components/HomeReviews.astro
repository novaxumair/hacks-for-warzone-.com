---
import { customerReviews, customerReviewStats } from '../data/site';
import { getReviewPath, reviewsBasePath } from '../data/reviews';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const reviews = customerReviews.map((review) => ({
	slug: review.slug,
	handle: review.handle,
	text: review.text,
	short: review.short,
	date: review.date,
	rating: review.rating,
	href: getReviewPath(review.slug),
}));

const ratingLabel = customerReviewStats.averageRating.toFixed(1);
const countLabel = customerReviewStats.reviewCountLabel || String(customerReviewStats.totalCount);

function formatDate(iso: string) {
	return new Date(`${iso}T12:00:00`).toLocaleDateString(locale === 'es' ? 'es-ES' : 'en-US', {
		month: 'long',
		year: 'numeric',
	});
}

function initial(handle: string) {
	return handle.replace(/^@/, '').charAt(0).toUpperCase();
}
---

<section class="reviews" aria-labelledby="reviews-title">
	<div class="shell">
		<header class="reviews__head">
			<div class="reviews__head-copy">
				<p class="reviews__eyebrow">{t('reviews.eyebrow')}</p>
				<h2 id="reviews-title">{t('reviews.homeTitle')}</h2>
			</div>
			<div
				class="reviews__score"
				aria-label={t('reviews.averageAria', { rating: ratingLabel, count: countLabel })}
			>
				<strong>{ratingLabel}</strong>
				<div>
					<span class="reviews__stars" aria-hidden="true">
						{
							[0, 1, 2, 3, 4].map(() => (
								<svg viewBox="0 0 20 20" fill="currentColor">
									<path d="M10 2.5l2.2 5.1 5.5.5-4.2 3.7 1.3 5.4L10 14.4 5.2 17.2l1.3-5.4L2.3 8.1l5.5-.5L10 2.5z" />
								</svg>
							))
						}
					</span>
					<p>{t('reviews.buyerReviews', { count: countLabel })}</p>
				</div>
			</div>
		</header>
	</div>

	<div class="reviews__marquee" data-marquee>
		<div class="reviews__track" data-reviews-track>
			<ul class="reviews__row" data-reviews-row>
				{
					reviews.map((review) => (
						<li>
							<article class="review-card">
								<p class="review-card__text">{review.short ?? review.text}</p>
								<footer class="review-card__foot">
									<span class="review-card__avatar" aria-hidden="true">
										{initial(review.handle)}
									</span>
									<div>
										<a class="review-card__name" href={review.href}>
											{review.handle}
										</a>
										<time datetime={review.date}>{formatDate(review.date)}</time>
									</div>
									<span
										class="review-card__rating"
										aria-label={t('reviews.outOfFiveAria', { rating: review.rating })}
									>
										{review.rating}/5
									</span>
								</footer>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<script is:inline>
		(function () {
			var marquee = document.querySelector('[data-marquee]');
			if (!marquee) return;
			var track = marquee.querySelector('[data-reviews-track]');
			var row = marquee.querySelector('[data-reviews-row]');
			if (!track || !row) return;
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			if (window.matchMedia('(max-width: 760px)').matches) return;
			var clone = row.cloneNode(true);
			clone.setAttribute('aria-hidden', 'true');
			clone.querySelectorAll('a.review-card__name').forEach(function (link) {
				var span = document.createElement('span');
				span.className = 'review-card__name';
				span.textContent = link.textContent;
				link.replaceWith(span);
			});
			track.appendChild(clone);
		})();
	</script>

	<div class="shell">
		<p class="reviews__more">
			<a href={reviewsBasePath}>{t('reviews.readAll')}</a>
		</p>
	</div>
</section>

<style is:global>
	.reviews {
		padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 3.5rem);
		background: transparent;
		border-top: 1px solid color-mix(in srgb, var(--magenta) 6%, var(--line-soft));
		overflow: hidden;
	}

	.reviews__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		margin: 0 0 1.75rem;
		padding-bottom: 1.35rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.reviews__head-copy {
		max-width: none;
		min-width: 0;
	}

	.reviews__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.reviews__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		line-height: 1.25;
		color: var(--ink);
	}

	.reviews__score {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
		margin-top: 0;
		padding: 0.7rem 0.95rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
	}

	.reviews__score strong {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		line-height: 1;
		color: var(--ink);
	}

	.reviews__stars {
		display: flex;
		gap: 0.12rem;
		color: var(--magenta-soft);
	}

	.reviews__stars svg {
		width: 0.85rem;
		height: 0.85rem;
	}

	.reviews__score p {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		color: var(--ink-faint);
		white-space: nowrap;
	}

	.reviews__marquee {
		position: relative;
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		content-visibility: auto;
		contain-intrinsic-size: 1px 220px;
	}

	.reviews__track {
		display: flex;
		width: max-content;
		animation: reviews-ltr 70s linear infinite;
		will-change: transform;
	}

	.reviews__row {
		display: flex;
		gap: 0.85rem;
		margin: 0;
		padding: 0.35rem 0.85rem 0.35rem 0;
		list-style: none;
	}

	.reviews__row > li {
		flex: 0 0 auto;
		width: min(20.5rem, 78vw);
	}

	.reviews__marquee:hover .reviews__track,
	.reviews__marquee:focus-within .reviews__track {
		animation-play-state: paused;
	}

	@media (max-width: 760px) {
		.reviews__head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
		}

		.reviews__score {
			width: 100%;
			justify-content: flex-start;
		}

		.reviews__score p {
			white-space: normal;
		}

		.reviews__marquee {
			mask-image: none;
			-webkit-mask-image: none;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}

		.reviews__marquee::-webkit-scrollbar {
			display: none;
		}

		.reviews__track {
			animation: none;
		}

		.reviews__row[aria-hidden='true'] {
			display: none;
		}

		.reviews__row {
			padding-inline: var(--page-gutter);
			gap: 0.75rem;
		}

		.reviews__row > li {
			width: min(18.5rem, 82vw);
			scroll-snap-align: start;
		}

		.review-card {
			min-height: 0;
		}

		a.review-card__name {
			min-height: 2.5rem;
			display: inline-flex;
			align-items: center;
		}
	}

	@media (max-width: 480px) {
		.reviews {
			padding-block: 2.25rem 2rem;
		}

		.reviews__row > li {
			width: min(17rem, 86vw);
		}
	}

	.review-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 11.5rem;
		padding: 1.2rem 1.15rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
	}

	.review-card:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		background: var(--bg-elevated);
		transform: translateY(-2px);
	}

	.review-card__text {
		margin: 0;
		flex: 1;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.review-card__foot {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.7rem;
		margin-top: 1.15rem;
		padding-top: 0.95rem;
		border-top: 1px solid var(--line-soft);
	}

	.review-card__avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--magenta) 16%, var(--bg-elevated));
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--magenta-soft);
	}

	.review-card__name {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
		line-height: 1.2;
		text-decoration: none;
	}

	a.review-card__name:hover {
		color: var(--accent-hover);
	}

	.review-card__foot time {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.review-card__rating {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--magenta-soft);
		white-space: nowrap;
	}

	.reviews__more {
		margin: 1.5rem 0 0;
		text-align: center;
	}

	.reviews__more a {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
	}

	.reviews__more a:hover {
		color: var(--accent-hover);
	}

	@keyframes reviews-ltr {
		from {
			transform: translateX(-50%);
		}
		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reviews__track {
			animation: none;
			flex-wrap: wrap;
			width: 100%;
			max-width: var(--page-max);
			margin-inline: auto;
			justify-content: center;
			padding-inline: var(--page-gutter);
		}

		.reviews__row[aria-hidden='true'] {
			display: none;
		}

		.reviews__marquee {
			mask-image: none;
			-webkit-mask-image: none;
		}

		.review-card:hover {
			transform: none;
		}
	}
</style>
