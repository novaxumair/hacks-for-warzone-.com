---
import NavbarApp from './react/Navbar';
import {
	getLocalizedPath,
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, locales, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { getForumLocaleSwitchHref, isForumPath } from '../data/forums/helpers';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const onForum = isForumPath(current);

const pageContext = onForum
	? pathContext
	: {
			...pathContext,
			pageId: pathContext.pageId ?? pageId,
		};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onForum) return getForumLocaleSwitchHref(current, targetLocale);
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const hrefForLocale = Object.fromEntries(
	locales.map((l) => [l.code, localeSwitchHref(l.code)]),
) as Record<string, string>;

const localeMetas = locales.map((l) => ({
	code: l.code,
	name: l.name,
	nativeName: l.nativeName,
	hreflang: l.hreflang,
	region: l.region,
}));

const links = [
	{ id: 'home', labelKey: 'nav.home', href: getLocalizedPath('home', locale) },
	{ id: 'hacks', labelKey: 'nav.preview', edit: 'navPreview', href: getLocalizedPath('hacks', locale) },
	{ id: 'esp', labelKey: 'nav.features', edit: 'navFeatures', href: getLocalizedPath('features', locale) },
	{ id: 'pricing', labelKey: 'nav.store', edit: 'navStore', href: getLocalizedPath('pricing', locale) },
	{ id: 'updates', labelKey: 'nav.status', edit: 'navStatus', href: getLocalizedPath('updates', locale) },
	{ id: 'reviews', labelKey: 'nav.reviews', edit: 'navReviews', href: reviewsBasePath },
];
---

<NavbarApp
	client:idle
	locale={locale}
	checkoutUrl={siteConfig.checkoutUrl}
	homeHref={getLocalizedPath('home', locale)}
	logoAlt={siteConfig.logoAlt}
	currentPath={current}
	reviewsBasePath={reviewsBasePath}
	locales={localeMetas}
	hrefForLocale={hrefForLocale}
	links={links}
/>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}

	.lang-switcher {
		position: relative;
	}

	.lang-switcher__panel {
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		z-index: 90;
		width: min(16rem, calc(100vw - 2rem));
		max-height: min(20rem, 70vh);
		overflow-y: auto;
		padding: 0.5rem;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
	}

	.lang-switcher__note {
		margin: 0 0 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
		color: var(--ink-muted);
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.25rem;
	}

	.lang-switcher__link {
		display: grid;
		gap: 0.1rem;
		padding: 0.55rem 0.65rem;
		border-radius: var(--radius-sm);
		color: var(--ink);
		transition: background 0.15s ease;
	}

	.lang-switcher__native {
		font-size: 0.86rem;
		font-weight: 700;
	}

	.lang-switcher__region {
		font-size: 0.68rem;
		color: var(--ink-muted);
	}

	.site-header .lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.15rem;
		padding: 0 0.75rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		list-style: none;
		cursor: pointer;
	}

	.site-header .lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.site-header .lang-switcher__toggle:hover {
		transform: translateY(-1px);
	}

	.site-header .lang-switcher__toggle svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.site-header .lang-switcher__panel {
		position: absolute;
		right: 0;
		left: auto;
		top: calc(100% + 0.45rem);
		min-width: 15rem;
		max-height: min(70vh, 22rem);
		overflow-y: auto;
		background: var(--bg-elevated);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
		z-index: 120;
	}

	.site-header .lang-switcher__link {
		color: var(--ink);
	}

	.site-header .lang-switcher__link:hover,
	.site-header .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
	}

	.site-panel .lang-switcher {
		width: 100%;
	}

	.site-panel .lang-switcher__toggle {
		width: 100%;
		justify-content: flex-start;
		height: 2.75rem;
		border-radius: var(--radius-sm);
	}

	.site-panel .lang-switcher__panel {
		position: static;
		margin-top: 0.45rem;
		max-height: min(12rem, 40dvh);
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
		box-shadow: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(12px) saturate(1.05);
		-webkit-backdrop-filter: blur(12px) saturate(1.05);
		border-bottom: 1px solid transparent;
		box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--line-soft) 55%, transparent);
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.site-header.is-scrolled,
	.site-header.is-open {
		background: color-mix(in srgb, var(--bg) 55%, transparent);
		border-bottom-color: color-mix(in srgb, var(--line-soft) 70%, transparent);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
	}

	.site-header__bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: var(--header-h);
		gap: 0.85rem;
		/* Match logo height to centered nav pill (padding + link tap target). */
		--nav-pill-h: calc(0.44rem + 0.8rem + 0.88rem);
	}

	.site-brand {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		justify-self: start;
		flex-shrink: 0;
		width: auto;
		height: var(--nav-pill-h);
		max-width: min(10.5rem, 28vw);
		min-width: 5.5rem;
		color: var(--ink-heading);
		text-decoration: none;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.site-brand:hover {
		opacity: 0.92;
		transform: translateY(-0.5px);
	}

	.site-brand__mark {
		width: auto;
		height: 100%;
		max-width: 100%;
		display: block;
		object-fit: contain;
		object-position: left center;
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		justify-self: center;
		min-width: 0;
		gap: 0.1rem;
		padding: 0.22rem;
		border: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-panel) 75%, transparent);
		box-shadow: inset 0 1px 0 color-mix(in srgb, var(--line) 65%, transparent);
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted);
		white-space: nowrap;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.site-nav a svg {
		width: 0.88rem;
		height: 0.88rem;
		flex-shrink: 0;
		opacity: 0.72;
	}

	.site-nav a:hover {
		color: var(--ink);
		background: color-mix(in srgb, var(--bg-hover) 80%, transparent);
	}

	.site-nav a:hover svg,
	.site-nav a.is-active svg {
		opacity: 1;
		color: var(--magenta-soft);
	}

	.site-nav a.is-active {
		color: var(--ink);
		background: color-mix(in srgb, var(--bg-hover) 90%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 70%, transparent);
	}

	.site-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		justify-self: end;
		gap: 0.45rem;
		min-width: 0;
	}

	.site-tools__buy {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.15rem;
		height: auto;
		padding: 0 1rem;
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.site-tools__buy svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	.site-tools__buy:hover {
		transform: translateY(-1px);
	}

	.site-menu {
		display: none;
		align-items: center;
		justify-content: center;
		width: var(--touch-min, 2.75rem);
		height: var(--touch-min, 2.75rem);
		padding: 0;
		border-radius: 999px;
		flex-shrink: 0;
	}

	.site-menu__bars {
		display: grid;
		gap: 3.5px;
		width: 0.95rem;
	}

	.site-menu__bars span {
		display: block;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
		transform-origin: center;
	}

	.site-header.is-open .site-menu__bars span:nth-child(1) {
		transform: translateY(5px) rotate(45deg);
	}

	.site-header.is-open .site-menu__bars span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-open .site-menu__bars span:nth-child(3) {
		transform: translateY(-5px) rotate(-45deg);
	}

	.site-panel {
		display: none;
		border-top: 1px solid var(--line-soft);
		background: var(--bg);
		padding: 0.35rem 0 max(1.35rem, env(safe-area-inset-bottom, 0px));
		max-height: min(70dvh, calc(100dvh - var(--header-h)));
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
		animation: panel-in 0.18s ease-out;
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.site-panel__nav {
		display: grid;
	}

	.site-panel__nav a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.85rem 0.15rem;
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		color: var(--ink-muted);
		border-bottom: 1px solid var(--line-soft);
	}

	.site-panel__nav a svg {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--magenta-soft);
		opacity: 0.9;
	}

	.site-panel__nav a:hover,
	.site-panel__nav a.is-active {
		color: var(--ink);
	}

	.site-panel__nav a.is-active {
		color: var(--link);
	}

	.site-panel__foot {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.1rem;
	}

	.site-panel__buy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.85rem;
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
	}

	.site-panel__buy:hover {
		transform: translateY(-1px);
	}

	@media (max-width: 1024px) {
		.site-nav,
		.site-tools__lang {
			display: none;
		}

		.site-header__bar {
			display: flex;
			justify-content: space-between;
			gap: 0.55rem;
		}

		.site-brand {
			justify-self: auto;
			height: 2.65rem;
			max-width: min(12rem, 52vw);
		}

		.site-tools {
			justify-self: auto;
			margin-left: auto;
		}

		.site-tools__buy {
			min-height: var(--touch-min, 2.75rem);
			padding-inline: 0.85rem;
			font-size: 0.8rem;
			flex-shrink: 0;
		}

		.site-menu {
			display: inline-flex;
		}

		.site-header.is-open {
			background: color-mix(in srgb, var(--bg) 88%, transparent);
		}

		.site-header.is-open .site-panel {
			display: block;
			position: fixed;
			inset-inline: 0;
			top: calc(var(--header-h) + var(--safe-top, 0px));
			z-index: 99;
			max-height: calc(100dvh - var(--header-h) - var(--safe-top, 0px) - var(--safe-bottom, 0px));
		}
	}

	@media (max-width: 480px) {
		.site-brand {
			height: 2.45rem;
			max-width: min(11rem, 58vw);
			min-width: 5rem;
		}

		.site-tools {
			gap: 0.4rem;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
		}
	}

	@media (max-width: 360px) {
		.site-tools__buy span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
			min-width: var(--touch-min);
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-nav a,
		.site-tools__buy,
		.site-menu__bars span,
		.site-panel {
			transition: none;
			animation: none;
		}

		.site-tools__buy:hover {
			transform: none;
		}
	}
</style>
